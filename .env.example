# =============================================================
# Cartoon Shorts Engine API Keys Configuration
# Copy this file to .env and insert your API keys:
# cp .env.example .env
# =============================================================

# Google Gemini API Key (Recommended for fast & free tier)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API Key (gpt-4o-mini)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude API Key (Claude 3.5 Haiku)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Local Ollama Host (Optional, default: http://localhost:11434)
OLLAMA_HOST=
