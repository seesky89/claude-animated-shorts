{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@shaders/*": ["src/shaders/*"],
      "@toon/*": ["src/toon/*"],
      "./paint": ["src/shaders/paint"],
      "./shade": ["src/shaders/shade"],
      "./lights": ["src/shaders/lights"],
      "./cardshade": ["src/shaders/cardshade"],
      "./ink": ["src/shaders/ink"],
      "./lensblur": ["src/shaders/lensblur"],
      "./grade": ["src/shaders/grade"],
      "./toon": ["src/toon/toon"]
    }
  },
  "include": ["src/**/*", "../../projects/**/*"]
}
