{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@shaders/*": ["src/shaders/*"],
      "@toon/*": ["src/toon/*"],
      "@project/*": ["../../projects/*"]
    }
  },
  "include": ["src/**/*", "../../projects/**/*"]
}
